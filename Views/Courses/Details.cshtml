@model Activity2.ViewModels.CourseDetailsViewModel
@{
    ViewData["Title"] = "Course Details";
}
<h1>Course Details</h1>
<div>
    <dl class="row">
        <dt class="col-sm-3">Course Code</dt>
        <dd class="col-sm-9">@Model.CourseCode</dd>

        <dt class="col-sm-3">Course Name</dt>
        <dd class="col-sm-9">@Model.CourseName</dd>

        <dt class="col-sm-3">Units</dt>
        <dd class="col-sm-9">@Model.Units</dd>
    </dl>
</div>
<a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-secondary">Edit</a>
<a asp-action="Index" class="btn btn-primary">Back to List</a>