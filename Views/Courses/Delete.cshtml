@model Activity2.ViewModels.CourseDetailsViewModel
@{
    ViewData["Title"] = "Delete Course";
}
<h1>Delete Course</h1>
<div asp-validation-summary="All" class="text-danger"></div>
<h3>Are you sure you want to delete this course?</h3>
<div>
    <dl class="row">
        <dt class="col-sm-3">Course Code</dt>
        <dd class="col-sm-9">@Model.CourseCode</dd>

        <dt class="col-sm-3">Course Name</dt>
        <dd class="col-sm-9">@Model.CourseName</dd>

        <dt class="col-sm-3">Units</dt>
        <dd class="col-sm-9">@Model.Units</dd>
    </dl>
</div>
<form asp-action="Delete" method="post">
    <input type="hidden" asp-for="Id" />
    <button type="submit" class="btn btn-danger">Delete</button>
    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
</form>