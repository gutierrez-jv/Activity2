@model Activity2.ViewModels.StudentDetailsViewModel

@{
    ViewData["Title"] = "Student Details";
}

<h1>Student Details</h1>

<dl class="row">
    <dt class="col-sm-2">Student Number</dt>
    <dd class="col-sm-10">@Model.StudentNumber</dd>

    <dt class="col-sm-2">Full Name</dt>
    <dd class="col-sm-10">@Model.FullName</dd>

    <dt class="col-sm-2">Email</dt>
    <dd class="col-sm-10">@Model.Email</dd>

    <dt class="col-sm-2">Date of Birth</dt>
    <dd class="col-sm-10">@Model.DateOfBirth</dd>
</dl>

<a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">Edit</a>
<a asp-action="Index" class="btn btn-secondary">Back to List</a>