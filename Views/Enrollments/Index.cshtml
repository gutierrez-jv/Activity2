@model List<Activity2.ViewModels.EnrollmentViewModel>
@{
    ViewData["Title"] = "Enrollments";
}
<h1>Enrollments</h1>
<p>
    <a asp-action="Create" class="btn btn-primary">Add Enrollment</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>Student</th>
            <th>Course</th>
            <th>Enrollment Date</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var enrollment in Model)
        {
            <tr>
                <td>@enrollment.StudentName</td>
                <td>@enrollment.CourseName</td>
                <td>@enrollment.EnrollmentDate</td>
                <td>
                    <a asp-action="Details" asp-route-id="@enrollment.Id" class="btn btn-sm btn-info">Details</a>
                    <a asp-action="Edit" asp-route-id="@enrollment.Id" class="btn btn-sm btn-secondary">Edit</a>
                    <a asp-action="Delete" asp-route-id="@enrollment.Id" class="btn btn-sm btn-danger">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>