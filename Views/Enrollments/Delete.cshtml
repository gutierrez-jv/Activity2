@model Activity2.ViewModels.EnrollmentDetailsViewModel
@{
    ViewData["Title"] = "Delete Enrollment";
}
<h1>Delete Enrollment</h1>
<div asp-validation-summary="All" class="text-danger"></div>
<h3>Are you sure you want to delete this enrollment?</h3>
<div>
    <dl class="row">
        <dt class="col-sm-3">Student</dt>
        <dd class="col-sm-9">@Model.StudentName</dd>

        <dt class="col-sm-3">Course</dt>
        <dd class="col-sm-9">@Model.CourseName</dd>

        <dt class="col-sm-3">Enrollment Date</dt>
        <dd class="col-sm-9">@Model.EnrollmentDate</dd>
    </dl>
</div>
<form asp-action="Delete" method="post">
    <input type="hidden" asp-for="Id" />
    <button type="submit" class="btn btn-danger">Delete</button>
    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
</form>